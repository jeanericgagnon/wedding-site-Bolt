# WeddingSite Platform — Environment Variables
# Copy this file to .env and fill in your values.

# ── Supabase (REQUIRED) ────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google Maps (OPTIONAL) ─────────────────────────────────────────
# Used for address autocomplete in venue inputs
# Enable "Maps JavaScript API" and "Places API" in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=

# ── AI behavior ────────────────────────────────────────────────────
# Keep model provider keys server-side only. Do not add provider keys with a VITE_ prefix.
VITE_FORCE_DETERMINISTIC_AI=false

# Supabase Edge Function secrets, set with:
# supabase secrets set OPENAI_API_KEY=... ONBOARDING_AI_MODEL=gpt-4.1-mini PHOTO_AI_MODEL=gpt-4.1-nano
# OPENAI_API_KEY=
# ONBOARDING_AI_MODEL=gpt-4.1-mini
# PHOTO_AI_MODEL=gpt-4.1-nano
VITE_REQUIRE_PAYMENT=true
VITE_ALLOW_PAYMENT_BYPASS=false
VITE_ENABLE_SMS_PROVIDER=false
# Set true only when vendor profile generation is intentionally launch-enabled.
VITE_ENABLE_VENDOR_PROFILE_CREATION=false

# ── Demo Mode (OPTIONAL) ───────────────────────────────────────────
# Set to "true" to allow the app to run without Supabase credentials
# Useful for UI demos and screenshots only — no data persists
VITE_DEMO_MODE=false

# ── Stripe (REQUIRED for payments) ─────────────────────────────────
# Publishable key is safe to expose in the frontend
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret key, webhook secret, and price ID live in Supabase edge function secrets (never in .env)
